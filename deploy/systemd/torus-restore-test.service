[Unit]
Description=Torus weekly backup restore test
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=rehaanmerchant
Group=docker
WorkingDirectory=/opt/torus/app
ExecStart=/usr/bin/flock --nonblock /opt/torus/state/torus-restore-test.lock /opt/torus/app/deploy/backup/restore-test.sh --host-run
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/torus/state /run/torus

[Install]
WantedBy=multi-user.target
