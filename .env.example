# Runtime mode: dev or prod.
ENV=
# Prevent external writes unless explicitly disabled in production.
DRY_RUN=
# Emergency stop for all integration jobs.
KILL_SWITCH=

# Per-job enable flags.
LEAD_SYNC_ENABLED=
BOOKING_SYNC_ENABLED=
KEEPALIVE_ENABLED=
HOST_HEALTH_ENABLED=

# Scheduler intervals and watchdog (safe defaults are enforced in code).
LEAD_SYNC_INTERVAL_SECONDS=
BOOKING_SYNC_INTERVAL_SECONDS=
HOST_HEALTH_INTERVAL_SECONDS=
KEEPALIVE_INTERVAL_SECONDS=
SCHEDULER_WATCHDOG_PATH=
SCHEDULER_WATCHDOG_MAX_AGE_SECONDS=

# External-write limits.
POSTHOG_BUDGET_PER_RUN=
POSTHOG_BUDGET_PER_DAY=
BETTERSTACK_BUDGET_PER_RUN=
BETTERSTACK_BUDGET_PER_DAY=
ZOHO_CREATE_BUDGET_PER_RUN=
ZOHO_CREATE_BUDGET_PER_DAY=
ZOHO_BOOKING_BUDGET_PER_RUN=
ZOHO_BOOKING_BUDGET_PER_DAY=

# Supabase service connectivity.
DATABASE_DSN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Zoho OAuth and API routing.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=
ZOHO_API_URL=
ZOHO_API_VERSION=
ZOHO_LEAD_FIELD_MAP_PATH=
ZOHO_BOOKING_FIELD_MAP_PATH=

# Google Calendar read-only integration.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_IMPERSONATED_USER=
GOOGLE_CALENDAR_ID=
GOOGLE_TOKEN_URL=
GOOGLE_CALENDAR_API_URL=
GOOGLE_BOOKING_LOOKBACK_DAYS=

# Verification and analytics integrations.
TURNSTILE_SECRET_KEY=
POSTHOG_API_KEY=
POSTHOG_HOST=

# Heartbeat endpoints.
BETTERSTACK_KEEPALIVE_URL=
BETTERSTACK_HOST_HEALTH_URL=
BETTERSTACK_BACKUP_URL=
BETTERSTACK_RESTORE_TEST_URL=

# Cloudflare Access validation.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUDIENCE=

# Digest-pinned Compose image coordinates.
GHCR_OWNER=
TIS_DIGEST=
CLOUDFLARED_DIGEST=
BACKUP_DIGEST=

# Tunnel sidecar.
TUNNEL_TOKEN=

# Encrypted backup destination and recipients.
BACKUP_DATABASE_DSN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
BACKUP_AGE_RECIPIENT=
RECOVERY_AGE_RECIPIENT=
RESTORE_TEST_AGE_PRIVATE_KEY=
R2_UPLOAD_BUDGET_PER_RUN=
R2_UPLOAD_BUDGET_PER_DAY=
R2_RETENTION_BUDGET_PER_RUN=
R2_RETENTION_BUDGET_PER_DAY=
GITHUB_RELEASE_TOKEN=
GITHUB_REPOSITORY=
